# Telegram bot token from @BotFather
TELEGRAM_TOKEN=

# OpenRouter API key: https://openrouter.ai/keys
OPENROUTER_TOKEN=

# Text-extraction model (cheap, structured-output capable). Override if you want.
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731

# Vision model used for receipt-photo OCR.
OPENROUTER_VISION_MODEL=deepseek/deepseek-v4-flash-vision-exp

# Comma-separated Telegram user IDs allowed to use the bot.
# Leave empty during first setup, run the bot, send /whoami to get your ID,
# then fill this in and restart -- otherwise ANYONE who finds the bot can use it.
ALLOWED_USER_IDS=

# IANA timezone used for month/period boundaries and the daily report job.
TZ=America/Sao_Paulo

# Path to the sqlite database, relative to the project root (or absolute).
DB_PATH=data/finance.db
